## Draws s into img at (x, y) (game pixels), one 8-pixel cell a letter; shadow: a black copy 1 pixel down-right.
static func draw_text(img: Image, x: int, y: int, s: String, color: Color, shadow := true) -> void:
	s = s.to_upper()
	for pass_ in ([0, 1] if shadow else [1]):
		var c: Color = Color.BLACK if pass_ == 0 else color
		var o: int = 1 if pass_ == 0 else 0
		for i in s.length():
			var rows: Array = GLYPHS.get(s[i], GLYPHS["?"])
			for r in rows.size():
				var bits: int = rows[r]
				if bits == 0:
					continue
				for b in 8:
					if bits & (0x80 >> b):
						_plot(img, x + i * 8 + b + o, y + r + o, c)


## Draws a 14 x 14 emblem letter ("#" a pixel) at (x, y), with a shadow.
static func draw_big(img: Image, x: int, y: int, letter: Array, color: Color) -> void:
	for pass_ in [0, 1]:
		var c: Color = Color.BLACK if pass_ == 0 else color
		var o: int = 1 if pass_ == 0 else 0
		for r in letter.size():
			var line: String = letter[r]
			for b in line.length():
				if line[b] == "#":
					_plot(img, x + b + o, y + r + o, c)


static func _plot(img: Image, x: int, y: int, c: Color) -> void:
	if x >= 0 and y >= 0 and x < img.get_width() and y < img.get_height():
		img.set_pixel(x, y, c)
